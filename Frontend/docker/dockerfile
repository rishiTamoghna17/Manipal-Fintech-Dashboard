# Multi-stage: Node build → nginx serve
# The bundle always calls the same-origin /api-proxy path (see .env), which nginx
# forwards to API_PROXY_TARGET at container start. No API URL is baked into the JS.

FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:stable-alpine
WORKDIR /usr/share/nginx/html
RUN rm -rf ./*
COPY --from=builder /app/dist .
# Rendered by the nginx entrypoint's envsubst at startup, so the upstream can be
# changed with an env var instead of a rebuild.
COPY docker/nginx-templates/default.conf.template /etc/nginx/templates/default.conf.template
